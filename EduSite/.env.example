# EduSite - Environment Configuration Example
# Copy to .env and fill in the values

# ============================================================
# REQUIRED IN PRODUCTION (DEV_MODE=0)
# ============================================================
# Flask secret key for signing sessions and CSRF tokens
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Admin panel password (will be scrypt-hashed on first run)
# Must be set in production
ADMIN_PASSWORD=

# Mock gateway secret (only used when DEV_MODE=1)
# In production, replace with real gateway credentials
MOCK_GATEWAY_SECRET=

# ============================================================
# APPLICATION SETTINGS
# ============================================================
# Set to 0 in production to disable mock SMS/payment and dev OTP display
DEV_MODE=0

# Base URL for canonical links, sitemap, OG tags
SITE_URL=http://localhost:5000

# Database path (inside container: /app/instance/edusite.db)
DATABASE_PATH=/app/instance/edusite.db

# ============================================================
# MONEY & PRICING (integer Toman)
# ============================================================
SESSION_PRICE=500000
TOPUP_AMOUNTS=[200000,500000,1000000]

# ============================================================
# CANCELLATION POLICY (configurable, not hard-coded)
# ============================================================
# Hours before session for 100% refund
CANCEL_FULL_HOURS=24
# Hours before session for partial refund (between PARTIAL_HOURS and FULL_HOURS)
CANCEL_PARTIAL_HOURS=6
# Percentage refund for partial window
CANCEL_PARTIAL_PERCENT=50

# ============================================================
# OTP SETTINGS
# ============================================================
OTP_TTL_SECONDS=120
OTP_MAX_ATTEMPTS=5
OTP_MAX_SENDS=3
OTP_SEND_WINDOW=600
OTP_RESEND_COOLDOWN=60

# ============================================================
# SCHEDULING
# ============================================================
SLOT_TIMES=[["15:30","17:00"],["17:00","18:30"],["18:30","20:00"]]
BOOKING_DAYS_AHEAD=14